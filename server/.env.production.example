NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://ics:change_me_db_password@db:5432/icsdb?schema=public

CORS_ORIGINS=https://your-domain.com

JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_COOKIE_MAX_AGE_MS=2592000000
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=true
