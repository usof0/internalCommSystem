generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique @db.VarChar(320)
  passwordHash String @db.VarChar(255)

  firstName   String? @db.VarChar(100)
  secondName  String? @db.VarChar(100)
  lastName    String? @db.VarChar(100)
  displayName String? @db.VarChar(160)
  avatarUrl   String? @db.VarChar(2048)

  isActive  Boolean   @default(true)
  isBlocked Boolean   @default(false)
  blockedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles               UserRole[]
  messages            Message[]
  createdRooms        Room[]
  createdTopics       Topic[]
  readMessages        UserReadMessage[]
  receivedMessages    UserReceiveMessage[]
  roomMemberships     UserRoomMembership[]
  createdTasks        Task[]              @relation("UserCreatedTask")
  taskParticipations  TaskParticipant[]
  createdEvents       Event[]             @relation("UserCreatedEvents")
  eventParticipations EventParticipant[]
  createdPolls        Poll[]              @relation("UserCreatedPolls")
  pollParticipations  PollParticipant[]
  actorNotifications  Notification[]      @relation("UserNotificationActor")
  notificationRecipients NotificationRecipient[]
  orgUnitMemberships  UserOrgUnitMembership[]
  topicVisibilityMembers TopicVisibilityMember[]
  refreshSessions     RefreshSession[]
  passwordResetRequests PasswordResetRequest[] @relation("PasswordResetUser")
  processedPasswordResetRequests PasswordResetRequest[] @relation("PasswordResetProcessedBy")
  processedRegistrationRequests RegistrationRequest[] @relation("RegistrationProcessedBy")

  @@index([createdAt])
  @@index([isActive, isBlocked])
  @@index([deletedAt])
}

model RefreshSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @db.VarChar(255)
  userAgent String?  @db.VarChar(512)
  ipAddress String?  @db.VarChar(80)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

enum PasswordResetStatus {
  PENDING
  APPROVED
  REJECTED
  USED
  EXPIRED
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RegistrationRequest {
  id           String                    @id @default(uuid()) @db.Uuid
  email        String                    @db.VarChar(320)
  passwordHash String                    @db.VarChar(255)
  firstName    String?                   @db.VarChar(100)
  secondName   String?                   @db.VarChar(100)
  lastName     String?                   @db.VarChar(100)
  displayName  String?                   @db.VarChar(160)
  status       RegistrationRequestStatus @default(PENDING)
  processedById String?                  @db.Uuid
  processedAt   DateTime?
  rejectReason  String?                  @db.Text
  createdUserId String?                  @db.Uuid
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  processedBy User? @relation("RegistrationProcessedBy", fields: [processedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([processedById])
  @@index([createdUserId])
}

model PasswordResetRequest {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @db.Uuid
  requestedEmail        String              @db.VarChar(320)
  reason                String?             @db.Text
  status                PasswordResetStatus @default(PENDING)
  temporaryPasswordHash String?             @db.VarChar(255)
  expiresAt             DateTime
  temporaryPasswordExpiresAt DateTime?
  processedById         String?             @db.Uuid
  processedAt           DateTime?
  rejectReason          String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user        User  @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User? @relation("PasswordResetProcessedBy", fields: [processedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([processedById])
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(120)
  description String? @db.VarChar(255)
  module      String? @db.VarChar(60)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles RolePermission[]
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users       UserRole[]
  permissions RolePermission[]
  positions   PositionRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ─── Chat enums ────────────────────────────────────────────────────────────────

enum RoomType {
  DIRECT
  GROUP
}

enum VisibilityScopeType {
  ALL_MEMBERS
  INCLUDE_MEMBERS
  EXCLUDE_MEMBERS
  ORG_UNIT
  ORG_UNIT_TAG
}

// ─── Chat models ───────────────────────────────────────────────────────────────

model Room {
  id          String    @id @default(uuid()) @db.Uuid
  creatorId   String    @db.Uuid
  type        RoomType  @default(GROUP)
  title       String
  description String?
  avatarUrl   String?   @db.VarChar(2048)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  creator     User                 @relation(fields: [creatorId], references: [id])
  topics      Topic[]
  memberships UserRoomMembership[]

  @@index([creatorId])
  @@index([type])
}

model Topic {
  id          String    @id @default(uuid()) @db.Uuid
  roomId      String    @db.Uuid
  creatorId   String    @db.Uuid
  title       String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  room            Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator         User                  @relation(fields: [creatorId], references: [id])
  messages        Message[]
  visibilityScope TopicVisibilityScope?

  @@index([roomId])
  @@index([creatorId])
}

model Message {
  id        String    @id @default(uuid()) @db.Uuid
  topicId   String    @db.Uuid
  authorId  String    @db.Uuid
  parentId  String?   @db.Uuid
  content   String
  level     Int
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  topic   Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Message?  @relation("MessageToMessage", fields: [parentId], references: [id])
  replies Message[] @relation("MessageToMessage")

  readBy     UserReadMessage[]
  receivedBy UserReceiveMessage[]

  @@index([topicId])
  @@index([authorId])
  @@index([parentId])
}

// ─── Topic Visibility Scope (replaces TopicVisibility) ────────────────────────

model TopicVisibilityScope {
  id              String              @id @default(uuid()) @db.Uuid
  topicId         String              @unique @db.Uuid
  scopeType       VisibilityScopeType
  includeSubUnits Boolean             @default(false)
  updatedAt       DateTime            @updatedAt

  topic          Topic                      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  memberEntries  TopicVisibilityMember[]
  orgUnitEntries TopicVisibilityOrgUnit[]
  tagEntries     TopicVisibilityOrgUnitTag[]

  @@index([topicId])
}

model TopicVisibilityMember {
  scopeId String @db.Uuid
  userId  String @db.Uuid

  scope TopicVisibilityScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([scopeId, userId])
  @@index([userId])
}

model TopicVisibilityOrgUnit {
  scopeId   String @db.Uuid
  orgUnitId String @db.Uuid

  scope   TopicVisibilityScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  orgUnit OrgUnit              @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@id([scopeId, orgUnitId])
  @@index([orgUnitId])
}

model TopicVisibilityOrgUnitTag {
  scopeId String @db.Uuid
  tagId   String @db.Uuid

  scope TopicVisibilityScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  tag   Tag                  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([scopeId, tagId])
  @@index([tagId])
}

// ─── Read / Receive tracking ──────────────────────────────────────────────────

model UserReadMessage {
  userId    String   @db.Uuid
  messageId String   @db.Uuid
  readAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
}

model UserReceiveMessage {
  userId     String   @db.Uuid
  messageId  String   @db.Uuid
  receivedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
}

// ─── Room RBAC ────────────────────────────────────────────────────────────────

model RoomRole {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  memberships         UserRoomMembership[]
  roleRoomPermissions RoleRoomPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomPermission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  description String?

  roleRoomPermissions RoleRoomPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleRoomPermission {
  roomRoleId       String @db.Uuid
  roomPermissionId String @db.Uuid

  roomRole       RoomRole       @relation(fields: [roomRoleId], references: [id], onDelete: Cascade)
  roomPermission RoomPermission @relation(fields: [roomPermissionId], references: [id], onDelete: Cascade)

  @@id([roomRoleId, roomPermissionId])
  @@index([roomPermissionId])
}

model UserRoomMembership {
  userId     String   @db.Uuid
  roomId     String   @db.Uuid
  roomRoleId String   @db.Uuid
  joinedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomRole RoomRole @relation(fields: [roomRoleId], references: [id])

  @@id([userId, roomId])
  @@index([roomId])
  @@index([roomRoleId])
}

// ─── Task models ──────────────────────────────────────────────────────────────

enum TaskWorkStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  DECLINED
}

enum TaskReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  creatorId   String    @db.Uuid
  title       String
  description String
  dueDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  creator      User              @relation("UserCreatedTask", fields: [creatorId], references: [id])
  participants TaskParticipant[]

  @@index([creatorId])
  @@index([dueDate])
}

model TaskParticipant {
  userId       String @db.Uuid
  taskId       String @db.Uuid

  workStatus   TaskWorkStatus
  reviewStatus TaskReviewStatus @default(PENDING)
  rating       Int?
  submittedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@index([taskId])
}

// ─── Event models ─────────────────────────────────────────────────────────────

model Event {
  id          String    @id @default(uuid()) @db.Uuid
  creatorId   String    @db.Uuid
  title       String
  description String    @db.Text
  address     String
  timeStart   DateTime
  timeEnd     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  creator      User               @relation("UserCreatedEvents", fields: [creatorId], references: [id])
  participants EventParticipant[]

  @@index([creatorId])
  @@index([timeStart])
  @@index([timeEnd])
}

model EventParticipant {
  userId            String  @db.Uuid
  eventId           String  @db.Uuid
  participantNumber Int
  confirmed         Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@unique([eventId, participantNumber])
  @@index([eventId])
}

// ─── Poll models ──────────────────────────────────────────────────────────────

model Poll {
  id              String    @id @default(uuid()) @db.Uuid
  creatorId       String    @db.Uuid
  title           String
  description     String    @db.Text
  allowVoteChange Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  creator      User              @relation("UserCreatedPolls", fields: [creatorId], references: [id])
  options      PollOption[]
  participants PollParticipant[]

  @@index([creatorId])
}

model PollOption {
  id        String    @id @default(uuid()) @db.Uuid
  pollId    String    @db.Uuid
  value     String
  chosen    Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@unique([pollId, value])
}

model PollParticipant {
  userId         String  @db.Uuid
  pollId         String  @db.Uuid
  done           Boolean @default(false)
  chosenOptionId String? @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@id([userId, pollId])
  @@index([pollId])
}

// ─── Notification models ──────────────────────────────────────────────────────

enum NotificationEntityType {
  ROOM
  TOPIC
  MESSAGE
  TASK
  EVENT
  POLL
}

model Notification {
  id         String                @id @default(uuid()) @db.Uuid
  type       String
  title      String
  body       String                @db.Text
  actorId    String?               @db.Uuid
  entityType NotificationEntityType
  entityId   String                @db.Uuid
  createdAt  DateTime              @default(now())

  actor      User?                   @relation("UserNotificationActor", fields: [actorId], references: [id])
  recipients NotificationRecipient[]

  @@index([actorId])
  @@index([entityType, entityId])
}

model NotificationRecipient {
  notificationId String    @db.Uuid
  userId         String    @db.Uuid

  deliveredAt DateTime?
  readAt      DateTime?
  isHidden    Boolean   @default(false)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@index([deliveredAt])
  @@index([readAt])
}

// ─── Organization models ──────────────────────────────────────────────────────

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  orgUnitTags          OrgUnitTag[]
  topicVisibilityTags  TopicVisibilityOrgUnitTag[]
}

model OrgUnit {
  id          String    @id @default(uuid()) @db.Uuid
  parentId    String?   @db.Uuid
  name        String
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent   OrgUnit?  @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitHierarchy")

  tags                 OrgUnitTag[]
  memberships          UserOrgUnitMembership[]
  topicVisibilityUnits TopicVisibilityOrgUnit[]

  @@index([parentId])
  @@unique([parentId, name])
}

model OrgUnitTag {
  orgUnitId String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())
  deletedAt DateTime?

  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([orgUnitId, tagId])
  @@index([tagId])
}

model Position {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  memberships   UserOrgUnitMembership[]
  positionRoles PositionRole[]
}

model PositionRole {
  positionId String @db.Uuid
  roleId     String @db.Uuid

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([positionId, roleId])
  @@index([roleId])
}

model UserOrgUnitMembership {
  userId     String   @db.Uuid
  orgUnitId  String   @db.Uuid
  positionId String   @db.Uuid
  joinedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnit  OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([userId, orgUnitId, positionId])
  @@index([orgUnitId])
  @@index([positionId])
}
